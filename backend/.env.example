# Application
DEBUG=true
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_64_CHAR_SECRET
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000"]

# Transactional email. Resend is preferred for a verified production domain.
RESEND_API_KEY=
EMAIL_FROM=Rencanix <onboarding@resend.dev>
# Alternative: personal Gmail/Outlook SMTP. Use an App Password, never the
# normal account password. Gmail: smtp.gmail.com:465 + SSL=true.
# Outlook: smtp.office365.com:587 + SSL=false.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM=
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60

# Local demo database. On Vercel replace with hosted PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite:///./cpmis_demo.db
DATABASE_INIT_ON_STARTUP=true

# AI default: endpoint serverless from the supplied Nemotron screenshot.
AI_DEFAULT_PROVIDER=mlapi
AI_DEFAULT_MODEL=nemotron-3-ultra
AI_FALLBACK_PROVIDER=openai
AI_TIMEOUT_SECONDS=90
MLAPI_API_KEY=
MLAPI_MODEL=nemotron-3-ultra
MLAPI_BASE_URL=https://mlapi.run/REPLACE_WITH_ACTIVE_ENDPOINT
MLAPI_MODELS_JSON={"nemotron-3-ultra":{"label":"Nemotron 3 Ultra","url":"https://mlapi.run/REPLACE_WITH_ACTIVE_ENDPOINT","payload_style":"messages","include_model":false}}
MLAPI_PAYLOAD_STYLE=messages
MLAPI_INCLUDE_MODEL=false
MLAPI_EXTRA_PAYLOAD_JSON=

# Optional OpenAI-compatible fallback/providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Telegram. Local: workers=true uses polling. Vercel: workers=false uses webhook.
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_AI_PARSE_ENABLED=true
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_RANDOM_TELEGRAM_WEBHOOK_SECRET
BACKGROUND_WORKERS_ENABLED=true

# One-time project dataset bootstrap/import
BOOTSTRAP_SECRET=CHANGE_ME_RANDOM_BOOTSTRAP_SECRET
BOOTSTRAP_MAX_UPLOAD_MB=20
DEMO_ADMIN_EMAIL=admin@cpmis.example.com
DEMO_ADMIN_PASSWORD=CHANGE_ME_MINIMUM_12_CHARS
DEMO_TELEGRAM_ID=

# External object storage (S3-compatible/MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=digicom-pmis-files
MINIO_SECURE=false

# Optional n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=CHANGE_ME_STRONG_N8N_SECRET
